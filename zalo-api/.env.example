# Bắt buộc, tối thiểu 16 ký tự. Sinh bằng: openssl rand -hex 24
API_KEY=change-me-to-a-long-random-string
PORT=3001
LOG_LEVEL=info
# Thư mục lưu phiên đăng nhập (auth/), zalo.db và media/
DATA_DIR=./data
# Tự tải file/ảnh/video/voice nhận được về DATA_DIR/media
AUTO_DOWNLOAD_MEDIA=true
# Nhận cả tin nhắn gửi từ điện thoại/máy khác của chính tài khoản (from_me=true)
SELF_LISTEN=true
# Giới hạn dung lượng file gửi đi qua /messages/send-file
MAX_UPLOAD_MB=100
# Webhook mặc định (tuỳ chọn); có thể đăng ký thêm bằng POST /webhooks
WEBHOOK_URL=
WEBHOOK_SECRET=
