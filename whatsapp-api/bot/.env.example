# Bắt buộc: khoá để gọi REST API (header x-api-key hoặc Authorization: Bearer ...)
API_KEY=doi-thanh-chuoi-ngau-nhien-dai

PORT=3000
LOG_LEVEL=info

# Thư mục dữ liệu (auth, DB, media). Trong Docker là volume /data
DATA_DIR=./data

# Tự tải ảnh/video/audio/file/sticker về đĩa khi nhận tin mới
AUTO_DOWNLOAD_MEDIA=true

# Xin điện thoại đẩy lịch sử đầy đủ lúc pair lần đầu (giả lập "Desktop").
# CẢNH BÁO: baileys@7.0.0-rc14 trên npm còn gửi nền tảng cũ (WIN32/DARWIN) nên WhatsApp
# từ chối kết nối (mã 428). Chỉ bật khi dùng bản có fix WIN_HYBRID (hiện mới ở nhánh master).
SYNC_FULL_HISTORY=false

# Tên hiện trong "Thiết bị đã liên kết" trên điện thoại
DEVICE_NAME=Data Bot

# Giới hạn dung lượng file gửi đi qua /messages/send-file
MAX_UPLOAD_MB=100

# Webhook mặc định (tuỳ chọn); có thể đăng ký thêm bằng POST /webhooks
WEBHOOK_URL=
WEBHOOK_SECRET=
